<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch background shown instantly while the Flutter engine starts up.
     Uses the brand teal color + the app icon so there is no white flash
     before the animated Flutter splash screen takes over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_color" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
